# ── Required ──────────────────────────────────────────────
# PostgreSQL 14+ (works with Supabase, Neon, RDS, Cloud SQL…)
DATABASE_URL=postgres://deceler:change-me@localhost:5432/deceler
# 32+ random characters. Signs file-access links. Generate: openssl rand -hex 32
APP_SECRET=
# Public URL of the app (used in emails, invitation links, sitemaps, canonical URLs)
APP_URL=https://app.example.com

# ── Platform administration ───────────────────────────────
# Comma-separated emails that become Platform Super Admins on sign-up.
PLATFORM_ADMIN_EMAILS=
# Development only: first registered user becomes platform admin (default: true in dev, false in production)
# BOOTSTRAP_FIRST_USER_AS_ADMIN=false

# ── Storage ───────────────────────────────────────────────
# Private directory for CVs and logos (mount a persistent volume in production)
STORAGE_DIR=/data/storage

# ── Optional services (features stay off / honest when unset) ──
# Transactional email. Without these, emails are recorded in the outbox as "not_configured".
SMTP_URL=
MAIL_FROM=
# ClamAV daemon for CV malware scanning. Without it, CVs are marked "not scanned".
CLAMAV_HOST=
CLAMAV_PORT=3310

# ── Tuning ────────────────────────────────────────────────
AUTO_MIGRATE=true
RATE_LIMIT_APPLY_PER_HOUR=20

# ── AI (Anthropic Claude, official SDK, server-side only) ──
# Without a key every AI action is disabled with a clear message; the CV Builder,
# Quick Check (approved questions) and deterministic answer checking still work.
ANTHROPIC_API_KEY=
# Optional overrides (default model: the platform setting, else claude-opus-5-5)
# ANTHROPIC_MODEL=
# ANTHROPIC_EFFORT=medium
